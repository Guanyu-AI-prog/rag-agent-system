<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>运营商套餐Agent - 智能客服</title>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --primary:#1a73e8;
  --primary-light:#e8f0fe;
  --primary-dark:#1557b0;
  --bg:#f0f2f5;
  --card:#ffffff;
  --text:#202124;
  --text-sec:#5f6368;
  --text-hint:#9aa0a6;
  --border:#dadce0;
  --success:#34a853;
  --error:#ea4335;
  --shadow:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.06);
  --shadow-lg:0 4px 16px rgba(0,0,0,.1);
  --radius:12px;
}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei','Noto Sans SC',sans-serif;background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column}

/* ── Header ── */
.header{
  background:linear-gradient(135deg,#1a73e8 0%,#4285f4 50%,#1a73e8 100%);
  padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;box-shadow:0 2px 8px rgba(26,115,232,.25);position:relative;z-index:10;
}
.header-left{display:flex;align-items:center;gap:14px}
.avatar-wrap{
  width:40px;height:40px;background:rgba(255,255,255,.2);border-radius:50%;
  display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);
  border:2px solid rgba(255,255,255,.3);position:relative;
}
.avatar-wrap::after{
  content:'';position:absolute;bottom:0;right:0;width:10px;height:10px;
  background:#34a853;border-radius:50%;border:2px solid #1a73e8;
}
/* 客服图标 SVG */
.avatar-wrap svg{width:24px;height:24px;fill:#fff}
.header-info{display:flex;flex-direction:column;gap:1px}
.header-title{color:#fff;font-size:16px;font-weight:600;letter-spacing:.3px}
.header-sub{color:rgba(255,255,255,.75);font-size:12px}
.header-right{display:flex;align-items:center;gap:12px}
.header-badge{
  display:flex;align-items:center;gap:5px;padding:4px 10px;
  background:rgba(255,255,255,.15);border-radius:20px;font-size:12px;color:#fff;
  backdrop-filter:blur(4px);
}
.header-badge .dot{width:6px;height:6px;border-radius:50%;background:#34a853;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.header-btn{
  background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);
  color:#fff;border-radius:8px;padding:6px 14px;font-size:12px;cursor:pointer;
  transition:all .15s;font-family:inherit;
}
.header-btn:hover{background:rgba(255,255,255,.25)}

/* ── Main Layout ── */
.main{flex:1;display:flex;overflow:hidden;max-width:1100px;margin:0 auto;width:100%}

/* ── Chat Area ── */
.chat-area{flex:1;display:flex;flex-direction:column;min-width:0}

/* ── Messages ── */
.msgs{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:16px}

/* Welcome Card */
.welcome-card{
  background:linear-gradient(135deg,#e8f0fe 0%,#f0f4ff 100%);
  border:1px solid #d2e3fc;border-radius:var(--radius);padding:20px;margin-bottom:8px;
}
.welcome-card .wc-title{font-size:15px;font-weight:600;color:var(--primary);margin-bottom:8px;display:flex;align-items:center;gap:8px}
.welcome-card .wc-desc{font-size:13px;color:var(--text-sec);line-height:1.7;margin-bottom:14px}
.quick-btns{display:flex;flex-wrap:wrap;gap:8px}
.quick-btn{
  background:#fff;border:1px solid var(--border);border-radius:20px;
  padding:7px 14px;font-size:12px;color:var(--primary);cursor:pointer;
  transition:all .15s;font-family:inherit;
}
.quick-btn:hover{background:var(--primary-light);border-color:var(--primary)}

/* Messages */
.msg{max-width:80%;animation:fadeIn .3s ease;display:flex;gap:10px}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.msg.user{align-self:flex-end;flex-direction:row-reverse}
.msg .msg-avatar{
  width:32px;height:32px;border-radius:50%;flex-shrink:0;display:flex;
  align-items:center;justify-content:center;font-size:14px;margin-top:2px;
}
.msg.bot .msg-avatar{background:var(--primary-light);color:var(--primary)}
.msg.user .msg-avatar{background:#e8f5e9;color:var(--success)}
.msg .msg-body{display:flex;flex-direction:column;gap:4px}
.msg .bubble{
  display:inline-block;padding:10px 16px;border-radius:var(--radius);
  line-height:1.7;font-size:14px;max-width:100%;word-break:break-word;
}
.msg.user .bubble{background:var(--primary);color:#fff;border-bottom-right-radius:4px}
.msg.bot .bubble{
  background:var(--card);border:1px solid var(--border);
  border-bottom-left-radius:4px;box-shadow:var(--shadow);
}
.msg .meta{font-size:11px;color:var(--text-hint);padding:0 4px;display:flex;align-items:center;gap:6px}
.msg.user .meta{justify-content:flex-end}

/* Bot markdown */
.msg.bot .bubble p{margin:6px 0}
.msg.bot .bubble p:first-child{margin-top:0}
.msg.bot .bubble p:last-child{margin-bottom:0}
.msg.bot .bubble table{border-collapse:collapse;width:100%;margin:8px 0;font-size:13px;border-radius:6px;overflow:hidden}
.msg.bot .bubble th,.msg.bot .bubble td{border:1px solid var(--border);padding:7px 10px;text-align:left}
.msg.bot .bubble th{background:var(--primary-light);font-weight:600;color:var(--text)}
.msg.bot .bubble tr:nth-child(even){background:#fafbfc}
.msg.bot .bubble code{padding:2px 5px;border-radius:4px;font-size:13px;background:#f1f3f4;color:#c5221f}
.msg.bot .bubble pre{background:#f8f9fa;padding:12px;border-radius:8px;overflow-x:auto;margin:8px 0;border:1px solid var(--border)}
.msg.bot .bubble pre code{background:none;padding:0;color:var(--text)}
.msg.bot .bubble ul,.msg.bot .bubble ol{padding-left:18px;margin:6px 0}
.msg.bot .bubble strong{color:var(--text)}
.msg.bot .bubble h1,.msg.bot .bubble h2,.msg.bot .bubble h3,.msg.bot .bubble h4{color:var(--text);margin:10px 0 6px}
.msg.bot .bubble blockquote{border-left:3px solid var(--primary);padding:6px 12px;margin:8px 0;background:var(--primary-light);border-radius:0 8px 8px 0;color:var(--text-sec)}

/* Source badge */
.source-line{align-self:flex-start;margin-top:-4px;margin-bottom:4px;padding:0 4px;display:flex;gap:6px;align-items:center}
.source-pill{
  display:inline-flex;align-items:center;gap:4px;font-size:12px;color:var(--text-hint);
  cursor:pointer;padding:4px 10px;border-radius:16px;background:#f1f3f4;
  transition:all .15s;user-select:none;border:1px solid transparent;
}
.source-pill:hover{background:#e8eaed;color:var(--text-sec);border-color:var(--border)}
.source-pill .arrow{font-size:8px;display:inline-block;transition:transform .2s}
.source-pill .arrow.open{transform:rotate(90deg)}
.source-panel{
  display:none;margin-top:6px;background:var(--card);border:1px solid var(--border);
  border-radius:8px;padding:10px 12px;font-size:12px;line-height:1.5;
  max-height:200px;overflow-y:auto;box-shadow:var(--shadow);width:100%;
}
.source-panel.open{display:block}
.source-panel .item{padding:6px 0;border-bottom:1px solid #f1f3f4;color:var(--text-sec);display:flex;gap:8px}
.source-panel .item:last-child{border:none}
.source-panel .tag{
  flex-shrink:0;width:18px;height:18px;line-height:18px;text-align:center;
  background:var(--primary);color:#fff;border-radius:4px;font-size:10px;margin-top:1px;
}

/* Error */
.msg.error .bubble{background:#fce8e6;border-color:#f5c6c2;color:var(--error)}

/* Typing */
.typing{
  display:flex;gap:4px;padding:12px 18px;background:var(--card);
  border:1px solid var(--border);border-radius:var(--radius);width:fit-content;
  align-self:flex-start;border-bottom-left-radius:4px;box-shadow:var(--shadow);
}
.typing span{width:6px;height:6px;background:#9aa0a6;border-radius:50%;animation:bounce 1.4s infinite}
.typing span:nth-child(2){animation-delay:.2s}
.typing span:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}

/* ── Input Area ── */
.input-area{
  flex-shrink:0;padding:14px 24px 18px;background:var(--card);
  border-top:1px solid var(--border);
}
.input-row{display:flex;gap:10px;align-items:flex-end;max-width:900px}
.input-wrap{
  flex:1;border:1.5px solid var(--border);border-radius:var(--radius);
  padding:0;transition:all .2s;background:#fafbfc;
}
.input-wrap:focus-within{border-color:var(--primary);background:#fff;box-shadow:0 0 0 3px rgba(26,115,232,.1)}
#msgInput{
  width:100%;border:none;background:transparent;padding:11px 16px;
  font-size:14px;color:var(--text);resize:none;outline:none;
  min-height:44px;max-height:120px;font-family:inherit;
}
#msgInput::placeholder{color:var(--text-hint)}
.send-btn{
  background:var(--primary);color:#fff;border:none;border-radius:var(--radius);
  padding:11px 24px;font-size:14px;font-weight:500;cursor:pointer;
  transition:all .15s;white-space:nowrap;height:44px;display:flex;align-items:center;gap:6px;
}
.send-btn:hover{background:var(--primary-dark)}
.send-btn:active{transform:scale(.97)}
.send-btn:disabled{opacity:.4;cursor:not-allowed}
.send-btn svg{width:16px;height:16px;fill:#fff}

/* ── Sidebar ── */
.sidebar{
  width:260px;flex-shrink:0;padding:16px;display:flex;flex-direction:column;
  gap:12px;overflow-y:auto;background:var(--bg);
}
.card{
  background:var(--card);border-radius:var(--radius);border:1px solid var(--border);
  padding:16px;box-shadow:var(--shadow);
}
.card-title{
  font-size:13px;font-weight:600;color:var(--text-sec);margin-bottom:12px;
  display:flex;align-items:center;gap:6px;
}

/* Agent Info Card */
.agent-info{display:flex;flex-direction:column;align-items:center;gap:10px;padding:8px 0}
.agent-avatar{
  width:56px;height:56px;background:linear-gradient(135deg,#1a73e8,#4285f4);
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  box-shadow:0 3px 12px rgba(26,115,232,.3);
}
.agent-avatar svg{width:30px;height:30px;fill:#fff}
.agent-name{font-size:15px;font-weight:600;color:var(--text)}
.agent-role{font-size:12px;color:var(--text-hint)}
.agent-tags{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-top:4px}
.agent-tag{
  font-size:11px;padding:3px 8px;border-radius:12px;
  background:var(--primary-light);color:var(--primary);
}

/* Stats */
.stat-row{display:flex;gap:8px}
.stat-box{flex:1;text-align:center;padding:10px 8px;background:#f8f9fa;border-radius:8px}
.stat-num{font-size:18px;font-weight:700;color:var(--primary)}
.stat-lbl{font-size:10px;color:var(--text-hint);margin-top:3px}

/* Actions */
.actions{display:flex;flex-direction:column;gap:6px}
.actions button{
  background:#f8f9fa;border:1px solid var(--border);border-radius:8px;
  padding:8px 12px;font-size:12px;cursor:pointer;color:var(--text-sec);
  display:flex;align-items:center;gap:6px;transition:all .12s;font-family:inherit;
}
.actions button:hover{background:#e8eaed;border-color:#c6c6c6}
.actions button.primary{background:var(--primary);color:#fff;border-color:var(--primary)}
.actions button.primary:hover{background:var(--primary-dark)}

/* Tips */
.tips{font-size:11px;color:var(--text-hint);line-height:1.8}
.tips li{margin-bottom:4px;list-style:none;padding-left:0}
.tips li::before{content:'•';color:var(--primary);margin-right:6px;font-weight:700}

/* ── Footer ── */
.footer{
  flex-shrink:0;text-align:center;padding:10px;font-size:11px;
  color:var(--text-hint);background:var(--card);border-top:1px solid var(--border);
}
.footer a{color:var(--primary);text-decoration:none}
.footer a:hover{text-decoration:underline}

/* ── Responsive ── */
@media(max-width:768px){
  .sidebar{display:none}
  .msg{max-width:92%}
  .main{padding:0}
  .msgs{padding:14px}
  .input-area{padding:10px 14px 14px}
  .header{padding:0 16px}
  .welcome-card{padding:14px}
  .quick-btns{gap:6px}
  .quick-btn{padding:6px 10px;font-size:11px}
}

/* ── Scrollbar ── */
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#c6c6c6;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#9aa0a6}
</style>
</head>
<body>

<!-- Header -->
<div class="header">
  <div class="header-left">
    <div class="avatar-wrap">
      <!-- 客服 headset icon -->
      <svg viewBox="0 0 24 24"><path d="M12 1c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z"/></svg>
    </div>
    <div class="header-info">
      <div class="header-title">运营商套餐Agent</div>
      <div class="header-sub">智能客服 · 在线服务中</div>
    </div>
  </div>
  <div class="header-right">
    <div class="header-badge"><span class="dot"></span> 在线</div>
    <button class="header-btn" onclick="window.open('/docs','_blank')">📚 API</button>
  </div>
</div>

<!-- Main -->
<div class="main">
  <!-- Chat -->
  <div class="chat-area">
    <div class="msgs" id="msgBox">
      <!-- Welcome -->
      <div class="welcome-card">
        <div class="wc-title">👋 您好，欢迎咨询！</div>
        <div class="wc-desc">
          我是运营商套餐智能客服助手，可以帮您查询套餐详情、对比方案、计算费用。请问有什么可以帮您？
        </div>
        <div class="quick-btns">
          <button class="quick-btn" onclick="quickAsk('59套餐包含多少流量')">59套餐流量</button>
          <button class="quick-btn" onclick="quickAsk('129套餐有宽带吗')">129套餐宽带</button>
          <button class="quick-btn" onclick="quickAsk('对比99和129套餐')">99元套餐对比129套餐</button>
          <button class="quick-btn" onclick="quickAsk('各套餐转网数量对比')">转网规则</button>
        </div>
      </div>
    </div>

    <div class="input-area">
      <div class="input-row">
        <div class="input-wrap">
          <textarea id="msgInput" placeholder="请输入您的问题，Enter 发送..." rows="1"></textarea>
        </div>
        <button class="send-btn" id="sendBtn">
          <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
          发送
        </button>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="sidebar">
    <!-- Agent Info -->
    <div class="card">
      <div class="agent-info">
        <div class="agent-avatar">
          <svg viewBox="0 0 24 24"><path d="M12 1c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z"/></svg>
        </div>
        <div class="agent-name">套餐智能客服</div>
        <div class="agent-role">AI Agent · 自主规划</div>
        <div class="agent-tags">
          <span class="agent-tag">🔍 套餐查询</span>
          <span class="agent-tag">📊 套餐对比</span>
          <span class="agent-tag">🧮 费用计算</span>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="card">
      <div class="card-title">📊 服务状态</div>
      <div class="stat-row">
        <div class="stat-box"><div class="stat-num" id="docCount">-</div><div class="stat-lbl">知识文档</div></div>
        <div class="stat-box"><div class="stat-num" id="respTime">-</div><div class="stat-lbl">响应耗时</div></div>
      </div>
    </div>

    <!-- Actions -->
    <div class="card">
      <div class="card-title">⚡ 快捷操作</div>
      <div class="actions">
        <button id="clearBtn">🗑️ 清空对话</button>
        <button id="refreshBtn">🔄 刷新状态</button>
        <button class="primary" id="apiBtn">📖 API 文档</button>
      </div>
    </div>

    <!-- Tips -->
    <div class="card">
      <div class="card-title">💡 使用提示</div>
      <ul class="tips">
        <li>Enter 发送，Ctrl+Enter 换行</li>
        <li>支持多轮对话上下文</li>
        <li>可直接问套餐对比和费用计算</li>
        <li>点击「📎 参考来源」查看详情</li>
      </ul>
    </div>
  </div>
</div>

<!-- Footer -->
<div class="footer">
  运营商套餐Agent · Powered by LangChain Agent + RAG · <a href="/docs" target="_blank">API 文档</a>
</div>

<script>
const BASE='';
const INPUT=document.getElementById('msgInput');
const BTN=document.getElementById('sendBtn');
const BOX=document.getElementById('msgBox');
const DOT=document.querySelector('.header-badge .dot');
const STXT=document.querySelector('.header-badge');
const SID='web_'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
let loading=false;

document.addEventListener('DOMContentLoaded',()=>{health();stats();events();resize()});

function events(){
  BTN.addEventListener('click',send);
  INPUT.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.ctrlKey&&!e.shiftKey){e.preventDefault();send()}});
  document.getElementById('clearBtn').addEventListener('click',clear);
  document.getElementById('refreshBtn').addEventListener('click',stats);
  document.getElementById('apiBtn').addEventListener('click',()=>window.open('/docs','_blank'));
}

function resize(){
  INPUT.addEventListener('input',function(){this.style.height='auto';this.style.height=Math.min(this.scrollHeight,120)+'px'});
}

function quickAsk(q){
  INPUT.value=q;
  INPUT.focus();
  send();
}

function renderMarkdown(t){
  if(typeof marked!=='undefined') return marked.parse(t);
  return t.replace(/\n/g,'<br>');
}

async function send(){
  const t=INPUT.value.trim();
  if(!t||loading) return;
  addMsg(t,'user');
  INPUT.value='';INPUT.style.height='auto';
  loading=true;BTN.disabled=true;
  const ti=typing();
  try{
    const r=await fetch(BASE+'/query/stream',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({question:t,session_id:SID,user_id:'web'})
    });
    ti.remove();
    if(!r.ok){addMsg('\u8bf7\u6c42\u5931\u8d25: '+r.statusText,'error');loading=false;BTN.disabled=false;return}

    const msgs=document.getElementById('msgs');
    const wrap=document.createElement('div');wrap.className='msg bot';
    const av=document.createElement('div');av.className='msg-avatar';av.textContent='\u{1F916}';
    const body=document.createElement('div');body.className='msg-body';
    const bubble=document.createElement('div');bubble.className='bubble';bubble.innerHTML='<span class="typing-dots"><span>.</span><span>.</span><span>.</span></span>';
    body.appendChild(bubble);wrap.appendChild(av);wrap.appendChild(body);msgs.appendChild(wrap);
    msgs.scrollTop=msgs.scrollHeight;

    let fullText='';
    const reader=r.body.getReader();
    const decoder=new TextDecoder();
    let buffer='';

    while(true){
      const{done,value}=await reader.read();
      if(done)break;
      buffer+=decoder.decode(value,{stream:true});
      const lines=buffer.split('\n');
      buffer=lines.pop();
      for(const line of lines){
        if(!line.startsWith('data: '))continue;
        try{
          const evt=JSON.parse(line.slice(6));
          if(evt.type==='route'){
            const rl={simple:'\u26a1 \u5feb\u901f\u67e5\u8be2',comparison:'\u{1F4CA} \u5bf9\u6bd4\u5206\u6790',complex:'\u{1F916} \u667a\u80fd\u63a8\u7406'}[evt.route]||evt.route;
            bubble.innerHTML='<span style="color:#1a73e8;font-size:12px">'+rl+'</span><br>';
          }else if(evt.type==='token'){
            // 打字机效果：按段落逐块渲染
            const newPart=evt.content;
            if(fullText.length===0){
              // 首次收到token，启动逐字渲染
              fullText=newPart;
              let idx=0;
              const typeInterval=setInterval(()=>{
                if(idx<fullText.length){
                  const chunk=Math.min(3,idx+fullText.length-idx);
                  idx+=chunk;
                  bubble.innerHTML=renderMarkdown(fullText.substring(0,idx));
                  msgs.scrollTop=msgs.scrollHeight;
                }else{clearInterval(typeInterval)}
              },15);
            }else{
              fullText+=newPart;
              bubble.innerHTML=renderMarkdown(fullText);
              msgs.scrollTop=msgs.scrollHeight;
            }
            continue;//skip old logic
            // OLD:
            fullText+=evt.content;
            bubble.innerHTML=renderMarkdown(fullText);
            msgs.scrollTop=msgs.scrollHeight;
          }else if(evt.type==='tool'){
            const td=document.createElement('div');
            td.style.cssText='margin:4px 0;padding:4px 8px;background:#fff3e0;border-radius:4px;font-size:12px;color:#e65100;';
            td.textContent='\u{1F527} \u8c03\u7528: '+evt.name+'('+JSON.stringify(evt.args)+')';
            body.insertBefore(td,bubble);
          }else if(evt.type==='tool_result'){
            const rd=document.createElement('div');
            rd.style.cssText='margin:4px 0;padding:4px 8px;background:#e8f5e9;border-radius:4px;font-size:12px;color:#2e7d32;max-height:60px;overflow:hidden;';
            rd.textContent='\u2705 '+evt.name+': '+evt.result.slice(0,100)+'...';
            body.insertBefore(rd,bubble);
          }else if(evt.type==='done'){
            if(fullText) bubble.innerHTML=renderMarkdown(fullText);
            if(evt.processing_time) document.getElementById('respTime').textContent=evt.processing_time.toFixed(1)+'s';
          }else if(evt.type==='error'){
            bubble.innerHTML='<span style="color:#ea4335">\u9519\u8bef: '+evt.message+'</span>';
          }
        }catch(e){}
      }
    }
    if(fullText) bubble.innerHTML=renderMarkdown(fullText);
    setStatus(true);
  }catch(e){ti.remove();addMsg('\u7f51\u7edc\u9519\u8bef: '+e.message,'error');setStatus(false)}
  finally{loading=false;BTN.disabled=false}
}}

function addThinkingSteps(steps){
  const container=document.createElement('div');
  container.className='thinking-steps';
  container.style.cssText='margin:10px 0;padding:10px;background:#f0f7ff;border-radius:8px;border-left:3px solid #1a73e8;font-size:13px;';

  const title=document.createElement('div');
  title.style.cssText='font-weight:600;margin-bottom:8px;color:#1a73e8;';
  title.innerHTML='🧠 思考过程';
  container.appendChild(title);

  steps.forEach(step=>{
    const stepDiv=document.createElement('div');
    stepDiv.style.cssText='margin:6px 0;padding:6px;background:#fff;border-radius:4px;border:1px solid #e0e0e0;';

    const toolName=document.createElement('div');
    toolName.style.cssText='font-weight:500;color:#333;';
    toolName.innerHTML=`📌 步骤 ${step.step}: <code>${step.tool}</code>`;

    const inputDiv=document.createElement('div');
    inputDiv.style.cssText='margin:4px 0;color:#666;font-size:12px;';
    inputDiv.innerHTML=`<strong>输入:</strong> ${escapeHtml(step.input)}`;

    const outputDiv=document.createElement('div');
    outputDiv.style.cssText='margin:4px 0;color:#666;font-size:12px;max-height:100px;overflow-y:auto;';
    outputDiv.innerHTML=`<strong>输出:</strong> ${escapeHtml(step.output)}`;

    stepDiv.appendChild(toolName);
    stepDiv.appendChild(inputDiv);
    stepDiv.appendChild(outputDiv);
    container.appendChild(stepDiv);
  });

  // 插入到聊天区域
  const msgBox=document.getElementById('msgBox');
  if(msgBox){
    msgBox.appendChild(container);
    msgBox.scrollTop=msgBox.scrollHeight;
  }
}

function addMsg(text,type){
  const d=document.createElement('div');
  d.className='msg '+(type==='error'?'error':type);

  // Avatar
  const av=document.createElement('div');
  av.className='msg-avatar';
  if(type==='user'){
    av.textContent='👤';
  }else{
    av.innerHTML='<svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:#1a73e8"><path d="M12 1c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z"/></svg>';
  }

  const body=document.createElement('div');
  body.className='msg-body';

  const b=document.createElement('div');
  b.className='bubble';
  const renderMd = typeof marked !== 'undefined' ? marked.parse : (t) => t.replace(/\n/g, '<br>');
  b.innerHTML=type==='bot'?renderMd(text):escapeHtml(text);

  const m=document.createElement('div');
  m.className='meta';
  const now=new Date();
  m.textContent=now.getHours().toString().padStart(2,'0')+':'+now.getMinutes().toString().padStart(2,'0');
  if(type==='bot'){
    const step=document.createElement('span');
    step.textContent='· Agent';
    m.appendChild(step);
  }

  body.appendChild(b);
  body.appendChild(m);
  d.appendChild(av);
  d.appendChild(body);
  BOX.appendChild(d);
  scroll();
  return d;
}

function addSrc(sources){
  const w=document.createElement('div');w.className='source-line';
  const p=document.createElement('span');p.className='source-pill';
  p.innerHTML='<span>📎</span> '+sources.length+' 篇参考 <span class="arrow">▶</span>';
  const panel=document.createElement('div');panel.className='source-panel';
  sources.forEach((s,i)=>{
    const item=document.createElement('div');item.className='item';
    const tag=document.createElement('span');tag.className='tag';tag.textContent=i+1;
    const txt=document.createElement('span');
    const clean=s.replace(/\s+/g,' ').trim();
    txt.textContent=clean.length>120?clean.slice(0,120)+'…':clean;
    item.appendChild(tag);item.appendChild(txt);panel.appendChild(item);
  });
  p.onclick=()=>{panel.classList.toggle('open');p.querySelector('.arrow').classList.toggle('open')};
  w.appendChild(p);w.appendChild(panel);
  BOX.appendChild(w);scroll();
}

function escapeHtml(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}

function typing(){
  const d=document.createElement('div');d.className='typing';
  d.innerHTML='<span></span><span></span><span></span>';
  BOX.appendChild(d);scroll();return d;
}

function clear(){
  if(!confirm('确定清空当前对话？')) return;
  BOX.innerHTML='';
  // Re-add welcome card
  const welcome=document.createElement('div');
  welcome.className='welcome-card';
  welcome.innerHTML=`<div class="wc-title">👋 您好，欢迎咨询！</div>
    <div class="wc-desc">我是运营商套餐智能客服助手，可以帮您查询套餐详情、对比方案、转网规则。请问有什么可以帮您？</div>
    <div class="quick-btns">
      <button class="quick-btn" onclick="quickAsk('59套餐包含多少流量')">59套餐流量</button>
      <button class="quick-btn" onclick="quickAsk('129套餐有宽带吗')">129套餐宽带</button>
      <button class="quick-btn" onclick="quickAsk('对比99和129套餐')">99元套餐对比129套餐</button>
      <button class="quick-btn" onclick="quickAsk('各套餐转网数量对比')">转网规则</button>
    </div>`;
  BOX.appendChild(welcome);
  fetch(BASE+'/conversation/clear?session_id='+SID).catch(()=>{});
}

async function health(){
  try{const r=await fetch(BASE+'/health');const d=await r.json();setStatus(d.status==='healthy')}
  catch{setStatus(false)}
}
function setStatus(ok){
  DOT.style.background=ok?'#34a853':'#ea4335';
  DOT.style.animation=ok?'pulse 2s infinite':'none';
}

async function stats(){
  try{
    const r=await fetch(BASE+'/stats');const d=await r.json();
    if(d.document_count!==undefined) document.getElementById('docCount').textContent=d.document_count;
    setStatus(true)
  }catch{setStatus(false)}
}
function scroll(){BOX.scrollTop=BOX.scrollHeight}
setInterval(health,30000);
</script>
</body>
</html>
