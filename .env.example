# RAG系统环境变量配置
# 复制此文件为 .env 并填入你的实际值

# ============== 必需配置 ==============
# SiliconFlow API密钥（必需）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# LLM模型配置
LLM_MODEL=THUDM/GLM-4-9B-0414
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ============== 嵌入模型配置 ==============
# 嵌入模型（使用本地模型）
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 重排序模型（可选，需要USE_RERANK=true）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANK=false
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_TIMEOUT=30
RERANK_MAX_RETRIES=2

# ============== 向量数据库配置 ==============
# ChromaDB路径
VECTOR_DB_PATH=./vector_db
COLLECTION_NAME=langchain_collection

# 文档分割配置
CHUNK_SIZE=300
CHUNK_OVERLAP=60
RETRIEVAL_K=3

# ============== 查询配置 ==============
MAX_QUERY_LENGTH=500
MAX_BATCH_SIZE=10

# ============== 性能配置 ==============
# 线程池大小（4核8GB推荐2）
MAX_WORKERS=2

# 缓存配置（秒）
CACHE_TTL=600
CACHE_MAX_SIZE=1000

# 查询超时（秒）
QUERY_TIMEOUT=120

# ============== 服务配置 ==============
# API服务配置
API_HOST=0.0.0.0
API_PORT=8001
DEBUG_MODE=false

# CORS配置（逗号分隔的域名列表，*表示允许所有）
CORS_ORIGINS=*

# 日志配置
LOG_LEVEL=INFO

# ============== 路径配置 ==============
# 知识库文档路径
DATA_DIR=./data

# 日志路径
LOG_DIR=./logs

# ============== 可选配置 ==============
# 钉钉机器人配置（如果需要）
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret

# ============== 示例配置 ==============
# 保存后运行：
# 1. python build_vectors.py --force  # 构建向量库
# 2. python api.py                    # 启动API服务
# 3. python workflow_langchain.py "测试问题"  # 测试查询
